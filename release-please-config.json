{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "le-media-auto",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "extra-files": [{ "type": "json", "path": "web/package.json", "jsonpath": "$.version" }],
      "changelog-sections": [
        { "type": "feat", "section": "Nouveautés" },
        { "type": "fix", "section": "Corrections" },
        { "type": "content", "section": "Contenu" },
        { "type": "perf", "section": "Performances" },
        { "type": "revert", "section": "Retours en arrière" },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "chore", "section": "Maintenance", "hidden": true }
      ]
    }
  }
}
